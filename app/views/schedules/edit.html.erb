<h2>予定の編集</h2>

<%= form_with model: @schedule do |f| %>
  <div class="field">
    <%= f.label :title, "タイトル", class: "label-note" %>
    <%= f.text_field :title, placeholder: "タイトル" %>
  </div>

  <div class="form-date">
    <div class="field">
      <%= f.label :start_date, "開始日", class: "label-note" %>
      <%= f.date_field :start_date %>
    </div>

    <div class="field">
      <%= f.label :end_date, "終了日", class: "label-note" %>
      <%= f.date_field :end_date %>
    </div>
  </div>

  <div class="check-field">
    <%= f.check_box :is_all_day %>
    <%= f.label :is_all_day, "終日の場合はチェックを入れます" %>
  </div>

  <div class="field">
    <%= f.label :memo, "スケジュールメモ" %>
    <%= f.text_area :memo, placeholder: "メモを入力する" %>
  </div>

  <ul class="btn-list">
    <li><%= link_to "キャンセル", schedules_path, class: "btn-cancel" %></li>
    <li><%= f.submit "保存", class: "btn-save" %></li>
  </ul>
<% end %>