<div class="schedules-head">
  <h2>予定一覧</h2>
  <p><%= link_to "新規作成", new_schedule_path, class: "new-btn" %></p>
</div>

<table class="table">
  <thead>
    <tr>
      <th>ID</th>
      <th>タイトル</th>
      <th>開始日</th>
      <th>終了日</th>
      <th>終日</th>
      <th>更新日時</th>
      <th colspan="3"></th>
    </tr>
  </thead>
  <tbody>
    <% @schedules.each do |schedule| %>
      <tr>
        <td><%= schedule.id %></td>
        <td><%= schedule.title %></td>
        <td><%= schedule.start_date.strftime("%Y/%m/%d") %></td>
        <td><%= schedule.end_date.strftime("%Y/%m/%d") %></td>
        <td>
          <% if schedule.is_all_day %>
              ○
          <% end %>
        </td>
        <td><%= schedule.updated_at.strftime("%Y/%m/%d %H:%M") %></td>
        <td><%= link_to "詳細", schedule_path(schedule) %></td>
        <td><%= link_to "編集", edit_schedule_path(schedule) %></td>
        <td><%= link_to "削除", schedule_path(schedule), data: { turbo_method: :delete, turbo_confirm: "予定を削除しますか？" } %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<% if flash[:notice] %>
  <p class="notice"><%= flash[:notice] %></p>
<% end %>

<div class="schedules-bottom">
  <p class="schedules-cnt">予定の合計数：<span><%= @schedules_count %> </span>件</p>
  <p>本日の日付：<%= Date.current.strftime("%Y/%m/%d") %></p>
</div>